#!/usr/bin/env python3
"""Add project archive checks here, then delegate optional repository checks."""
import json
import os
from pathlib import Path
import subprocess
import sys


context = json.load(sys.stdin)
for record in context["repos"]:
    source = Path(record["source"])
    entry = source / ".local" / "hooks" / "before_task_archive"
    if not entry.exists() and not entry.is_symlink():
        continue
    if entry.is_symlink() or not entry.is_file() or not os.access(entry, os.X_OK):
        sys.exit(f"repo before_task_archive hook must be an executable regular file: {entry}")
    context["repo"] = record["name"]
    result = subprocess.run([str(entry)], input=json.dumps(context).encode(), cwd=source)
    if result.returncode:
        sys.exit(result.returncode)
