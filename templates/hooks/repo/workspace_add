#!/usr/bin/env python3
"""Adapter for an existing .local/create_worktree.sh BASE BRANCH WORKSPACE entry."""
import json
from pathlib import Path
import subprocess
import sys


context = json.load(sys.stdin)
record = next(item for item in context["repos"] if item["name"] == context["repo"])
source = Path(record["source"])
entry = source / ".local" / "create_worktree.sh"
if entry.is_symlink() or not entry.is_file():
    sys.exit(f"legacy worktree entry must be a regular file: {entry}")
sys.exit(subprocess.run(["bash", str(entry), record["base"], record["branch"],
                         context["task"]["workspace"]], cwd=source).returncode)
